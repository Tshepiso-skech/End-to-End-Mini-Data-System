# Load required libraries
library(dplyr)       # Provides the %>% pipe operator
library(knitr)       # Provides the kable function
library(kableExtra)  # Provides kable_styling, column_spec, etc.
#Read data
setwd('C:/Users/tshep/mobile_carwash/data/statistics/revenue_metrics')
revenue_loss_summary=read.csv('revenue_loss_summary.csv',header = TRUE)
revenue_loss_summary %>%
kable(
caption = "Revenue Loss Summary Over the Non-Active Period",
digits = 2
) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed")) %>%
column_spec(1, bold = TRUE)
rm(loss_summary)
loss_summary=data.frame(
Metric = c(
"Active Days",
"Gap Days",
"Mean Daily Revenue (Active)",
"Median Daily Revenue (Active)",
"Estimated Loss (Mean-Based)",
"Estimated Loss (Median-Based)",
"95% CI for Loss (Mean-Based)"))
loss_summary$Value=c(n_active,
n_gap,
round(active_revenue_summary$average_revenue, 3),
active_revenue_summary$median,
round(Loss_mean, 3),
loss_median,
