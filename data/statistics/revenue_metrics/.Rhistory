#initialize parameters
n_simulation=20
die=1:6
board_size=10
current_position=1
#simulate game
set.seed(1)
positions=numeric(n_simulation+1)
positions[1]=current_position
for (i in 1:n_simulation) {
#roll die
die_roll=sample(die,size = 1)
#position update
#keep in bound
new_postion= (positions[i]+die_roll-1)%%board_size +1
positions[i+1]=new_postion
}
print(positions)
