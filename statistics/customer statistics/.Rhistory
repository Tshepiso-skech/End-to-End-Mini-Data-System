COUNT CONSECUTIVE ZEROS
#COUNT CONSECUTIVE ZEROS
daily_revenue$gap= ave(daily_revenue$payment_amount==0,
cumsum(daily_revenue$payment_amount!=0),
FUN = cumsum)
View(daily_revenue)
#IDENTIFY GAPS LONGER 7 DAYS
long_zeros=daily[daily_revenue$gap>7, ]
