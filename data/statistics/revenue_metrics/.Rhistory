#Instead of pre-generating 1000 inter-arrival times,
#generate them one by one and
#stop when you exceed the time horizon:
lambda=2
Tmax=10
arrival_times4=c()
current_time=0
lambda=2
Tmax=10
arrival_times4=c()
current_time=0
while (current_time<Tmax) {
interarrival_times4=rexp(1,lambda)
current_time=current_time+interarrival_times4
if(current_time<=Tmax){
arrival_times4=c(arrival_times4,current_time)
}
}
